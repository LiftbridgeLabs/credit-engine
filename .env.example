DATABASE_URL=postgresql+psycopg2://creditengine:creditengine@postgres:5432/creditengine
REDIS_URL=redis://redis:6379/0

# Signs session tokens for local CreditEngine accounts — keep this secret, rotate it and every session invalidates.
SECRET_KEY=

# Generated once and reused for every Plex PIN auth request — treat like an app identity, not a secret.
PLEX_CLIENT_IDENTIFIER=
PLEX_PRODUCT=CreditEngine
