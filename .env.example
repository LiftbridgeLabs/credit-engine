DATABASE_URL=postgresql+psycopg2://creditengine:creditengine@postgres:5432/creditengine
REDIS_URL=redis://redis:6379/0

# Signs session tokens for local CreditEngine accounts — keep this secret, rotate it and every session invalidates.
SECRET_KEY=

# Generated once and reused for every Plex PIN auth request — treat like an app identity, not a secret.
PLEX_CLIENT_IDENTIFIER=
PLEX_PRODUCT=CreditEngine

# Seed value only. The library sync interval lives in the database and is edited on the Settings
# page; this is just what that setting starts at on a fresh install (or carries over from, the one
# time an existing install gains the column). Changing it later has no effect — use Settings.
CONTENT_SYNC_INTERVAL_HOURS=24
